# Keep this course workspace publishable without tracking large local inputs.
/*
!/.gitignore
!/*.py
!/README*.md
!/requirements-experiment.txt
!/experiment_environment.json
!/experiment_literature.csv
!/tests/
!/outputs/
!/_work/
!/analysis/
!/Report/
!/Report/**
!/2026数据挖掘技术期末专题大作业/
/_work/*
!/_work/download_things_eeg2.py
/analysis/**
!/analysis/*.md
!/analysis/_evidence/
!/analysis/_evidence/raw/
!/analysis/_evidence/raw/*.txt
!/analysis/_evidence/raw/*.json
!/analysis/_evidence/checkpoints/
!/analysis/_evidence/checkpoints/*.md
!/analysis/_evidence/supplements/
!/analysis/_evidence/supplements/*/
!/analysis/_evidence/supplements/*/*.md
/outputs/**
!/outputs/**/
!/outputs/batch.json
!/outputs/frozen.json
!/outputs/development_selection.csv
!/outputs/**/protocol.json
!/outputs/**/summary.json
!/outputs/**/paired_runs.csv
!/outputs/**/paired_vs_random.csv
!/outputs/**/arm_counts.csv
!/outputs/**/sampling_audit.json
!/outputs/**/cnn_protocol.json
!/outputs/**/cnn_runs.csv
!/outputs/**/paired_differences.csv
!/outputs/gemini_iterations/README.md
!/outputs/evaluation/*.csv
!/outputs/evaluation/status.json
!/outputs/querybank/diagnostics/*/runs.csv
__pycache__/
*.pyc
*.tmp
~$*
